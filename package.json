{
  "name": "orientavoto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "build:prod": "DEPLOY_ENV=production npm run build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate.ts",
    "schemas": "tsx scripts/generate-schemas.ts",
    "lint": "eslint . --quiet",
    "typecheck": "astro check",
    "test": "vitest run --reporter=dot --silent=passed-only --passWithNoTests",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:e2e": "playwright test --reporter=dot --quiet",
    "test:e2e:update": "playwright test --update-snapshots --reporter=dot --quiet",
    "check": "npm run lint && npm run typecheck && npm run validate && npm test"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/preact": "6.1.1",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "astro": "7.4.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
