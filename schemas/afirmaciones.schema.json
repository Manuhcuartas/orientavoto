{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^a\\d{2}$",
        "description": "Identificador de afirmación, p. ej. «a01»."
      },
      "texto": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es"
        ],
        "additionalProperties": false
      },
      "tema": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es"
        ],
        "additionalProperties": false
      },
      "explicacion": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "texto",
      "tema"
    ],
    "additionalProperties": false
  }
}
