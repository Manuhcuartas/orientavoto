{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Identificador en kebab-case y minúsculas, p. ej. «partido-a»."
      },
      "nombre": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es"
        ],
        "additionalProperties": false
      },
      "siglas": {
        "type": "string",
        "minLength": 1
      },
      "partidoReferencia": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Partido del que hereda las posiciones."
      },
      "incluye": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Identificador en kebab-case y minúsculas, p. ej. «partido-a»."
        }
      }
    },
    "required": [
      "id",
      "nombre",
      "siglas",
      "partidoReferencia",
      "incluye"
    ],
    "additionalProperties": false
  }
}
